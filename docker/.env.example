# ─── Jellyfin ─────────────────────────────────────────────────────────────────
JELLYFIN_URL=http://192.168.1.x:8096
JELLYFIN_API_KEY=your_api_key_here
# Comma-separated user IDs — play history is merged across all of them
JELLYFIN_USER_IDS=user_id_1,user_id_2

# ─── Storage paths ─────────────────────────────────────────────────────────────
# Comma-separated list of hot directories (one per media category)
HOT_DIRS=/mnt/media/movies,/mnt/media/shows
# WebDAV mount point where cold storage is accessible locally
COLD_PATH=/mnt/cold

# ─── Volume mounts (host paths bound into the containers) ──────────────────────
HOST_MEDIA_VOLUME=/mnt/media         # host path to your media drive root
CONTAINER_MEDIA_ROOT=/mnt/media      # container-side mount target — must match prefix of HOT_DIRS
COLD_MOUNT=/mnt/cold                 # host path to cold storage mount
RCLONE_CONFIG=/home/user/.config/rclone
LOGS_VOLUME=/mnt/media/_logs

# ─── Rclone ────────────────────────────────────────────────────────────────────
RCLONE_BIN=/usr/local/bin/rclone
RCLONE_REMOTE=GDrive:path/to/Cold   # remote:path as configured in rclone.conf
RCLONE_CHUNK_SIZE=128M
RCLONE_UPLOAD_CUTOFF=128M
RCLONE_STATS_INTERVAL=5s

# ─── Archive thresholds ────────────────────────────────────────────────────────
MOVIE_PLAYED_COLD_DAYS=7             # days since last play → archive
MOVIE_NEVER_WATCHED_COLD_DAYS=30     # days since added, never watched → archive
MOVIE_ABANDONED_DAYS=14              # days in-progress with no activity → archive
SHOW_INACTIVITY_COLD_DAYS=14         # days since any episode played → archive show
SHOW_ALL_WATCHED_COLD_DAYS=7         # days after finishing a show → archive

# ─── Archive run ───────────────────────────────────────────────────────────────
MAX_GB=700                           # max GB to upload per run (GDrive: 750 GB/day)
MAX_RETRIES=3
RETRY_WAIT_SEC=30
RUN_MODE=archive                     # archive | dry_run

# ─── Listener ──────────────────────────────────────────────────────────────────
# false = background recall (GDrive, symlink stays while downloading)
# true  = blocking recall (NAS, faster — symlink removed first)
RECALL_BLOCKING=false

# ─── Files ─────────────────────────────────────────────────────────────────────
EXTS=.mkv,.mp4,.avi,.mov
KEEP_HOT=                            # comma-separated filenames to never archive

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_BASE_DIR=/logs
